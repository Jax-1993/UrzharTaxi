
<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ҮРЖАР TAXI — Жүргізуші кабинеті</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101522;color:#fff;font-family:Arial,sans-serif}
header{background:#202a3b;padding:20px;text-align:center;border-bottom:2px solid #ffcc00}
header h2{margin:0;color:#ffcc00}
main{max-width:650px;margin:auto;padding:16px}
.card{background:#202a3b;border-radius:15px;padding:17px;margin:14px 0}
h3{margin-top:0;color:#ffcc00}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:#303d52;padding:15px;border-radius:12px}
.stat small{color:#c5cede}
.stat strong{display:block;font-size:22px;margin-top:8px}
button{background:#ffcc00;color:#151515;border:0;padding:13px 18px;border-radius:9px;font-weight:bold;cursor:pointer}
button:disabled{opacity:.5}
.order{background:#303d52;padding:14px;border-radius:10px;margin:10px 0}
.muted{color:#b9c2d0;font-size:13px}
.error{color:#ff9999}
</style>
</head>
<body>
<header>
<h2>🚕 ҮРЖАР TAXI</h2>
<div>Жүргізуші кабинеті</div>
</header>

<main>
<div class="card">
<h3>📊 Менің статистикам</h3>
<div class="stats">
<div class="stat">
<small>Орындалған сапар</small>
<strong id="rides">—</strong>
</div>
<div class="stat">
<small>Жалпы айналым</small>
<strong id="gross">—</strong>
</div>
<div class="stat">
<small>Жүргізуші табысы</small>
<strong id="earning">—</strong>
</div>
<div class="stat">
<small>10% комиссия</small>
<strong id="commission">—</strong>
</div>
</div>
</div>

<div class="card">
<h3>📅 Апталық комиссия</h3>
<p>Төленбеген: <strong id="unpaid">—</strong></p>
<p>Төленген: <strong id="paid">—</strong></p>
<p class="muted" id="week"></p>
</div>

<div class="card">
<h3>🚕 Менің тапсырыстарым</h3>
<div id="orders" class="muted">Тапсырыстар жүктелуде...</div>
</div>

<div class="card">
<button onclick="loadAll()" id="refresh">Жаңарту</button>
<p id="message" class="muted"></p>
</div>
</main>

<script>
const money = n =>
  Number(n || 0).toLocaleString("kk-KZ") + " ₸";

async function api(url) {
  const response = await fetch(url, {
    credentials: "include"
  });

  const data = await response.json();

  if (!response.ok || data.success === false) {
    throw new Error(data.message || "Қате орын алды");
  }

  return data;
}

async function loadStats() {
  const data = await api("/api/driver-stats");

  document.getElementById("rides").textContent =
    data.ridesCount;

  document.getElementById("gross").textContent =
    money(data.grossTotal);

  document.getElementById("earning").textContent =
    money(data.driverEarning);

  document.getElementById("commission").textContent =
    money(data.commissionTotal);

  document.getElementById("unpaid").textContent =
    money(data.weekly.unpaid);

  document.getElementById("paid").textContent =
    money(data.weekly.paid);

  document.getElementById("week").textContent =
    "Апта: " +
    new Date(data.weekly.start).toLocaleDateString("kk-KZ") +
    " — " +
    new Date(data.weekly.end).toLocaleDateString("kk-KZ");
}

async function loadOrders() {
  const data = await api("/api/driver-orders");

  const list = Array.isArray(data)
    ? data
    : (data.orders || []);

  const container = document.getElementById("orders");
  container.innerHTML = "";

  if (!list.length) {
    container.textContent = "Әзірге тапсырыс жоқ";
    return;
  }

  list.forEach(order => {
    const item = document.createElement("div");
    item.className = "order";

    const pickup = document.createElement("p");
    pickup.textContent = "📍 Қайдан: " +
      (order.pickup_address || "Көрсетілмеген");

    const destination = document.createElement("p");
    destination.textContent = "🏁 Қайда: " +
      (order.destination_address || "Көрсетілмеген");

    const price = document.createElement("p");
    price.textContent = "💰 Бағасы: " + money(order.price);

    const status = document.createElement("p");
    status.textContent = "Мәртебесі: " + (order.status || "");

    item.append(pickup, destination, price, status);
    container.appendChild(item);
  });
}

async function loadAll() {
  const button = document.getElementById("refresh");
  const message = document.getElementById("message");

  button.disabled = true;
  message.textContent = "Жүктелуде...";

  try {
    await Promise.all([loadStats(), loadOrders()]);
    message.textContent = "Мәліметтер жаңартылды";
  } catch (error) {
    message.textContent = error.message;
    message.className = "error";
  } finally {
    button.disabled = false;
  }
}

loadAll();
</script>
</body>
</html>
