# =====================================================
# ҮРЖАР TAXI — Environment Variables
# =====================================================
# Бұл файлдың көшірмесін .env деп сақтап, нақты мәндерді толтырыңыз
# Vercel-де: Project Settings → Environment Variables
# =====================================================

# ===== SUPABASE (міндетті) =====
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ===== ADMIN (міндетті) =====
# Әкімші панеліне кіру құпиясөзі (мықты құпиясөз, 16+ таңба)
ADMIN_PASSWORD=your_strong_admin_password_here

# ===== TELEGRAM (міндетті емес — бірақ ұсынылады) =====
# Жаңа тапсырыстар туралы Telegram-ға хабарлама
# 1. @BotFather → /newbot → токен алыңыз
# 2. Ботты чатқа қосыңыз
# 3. Chat ID: @userinfobot арқылы алыңыз
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890
